# HUD fonts are binary TTFs — not committed; CI fetches them from Google
# Fonts (OFL) at build time (see .github/workflows/build-apk.yml).
# The manual pipeline (scripts/build-apk.sh) uses the local copies.
android/app/src/main/assets/web/fonts/*.ttf
web/fonts/*.ttf

# Android build outputs
android/app/build/
android/build/
android/.gradle/
android/local.properties
*.iml
.idea/
*.apk
*.aab
# Generated HUD assets (rebuilt by the copyHud Gradle task from web/
# into assets/hud/). The HUD source itself lives in
# android/app/src/main/assets/web/ and IS tracked.
android/app/src/main/assets/hud/
# Generated wake-model assets (rebuilt by the copyWakeModels Gradle
# task from wake/*.onnx into assets/wake/). The models in wake/ ARE
# tracked; the venv used to train them is not.
android/app/src/main/assets/wake/
wake/venv/
wake/data/
wake/__pycache__/
wake/*.npy
wake/val_stream.wav
mini/__pycache__/

# Downloaded Android dependencies (reproducible: android/libs/resolve.py
# + resolved.txt re-download them). Keep resolve.py + resolved.txt.
android/libs/*.aar
android/libs/*.jar

# Signing — never commit
*.keystore
*.jks
keystore.properties

# Secrets — never commit
secrets.yaml
*.token
.env

# OS
.DS_Store
Thumbs.db

# Node (if the web HUD is built with tooling)
node_modules/
dist/
