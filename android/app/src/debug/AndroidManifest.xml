<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only storage read so an adb-pushed WAV under /sdcard/Download
     can be fed to the wake pipeline. Release builds do not merge this.
     On Android 11 the Download folder still needs
     `adb shell appops set <pkg> MANAGE_EXTERNAL_STORAGE allow`,
     or push the file into the app external-files dir instead.
     See docs/wake-vosk-test.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
</manifest>
