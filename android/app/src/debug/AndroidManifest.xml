<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only storage read so an adb-pushed WAV under /sdcard/Download
     can be fed to the wake pipeline. Release builds do not merge this.
     On Android 11 the Download folder still needs
     `adb shell appops set <pkg> MANAGE_EXTERNAL_STORAGE allow`,
     or push the file into the app external-files dir instead.
     See docs/wake-vosk-test.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Debug builds only: `am start -n net.npalakurla.jarvis.tablet/.SettingsActivity`.
         The release activity stays exported=false. -->
    <application>
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
